<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  BTK-CustomRPR2-module.xml - a FOM MODULE that extends stock RPR 2.0 with the same two
  custom attributes BTK-CustomRPR1.fed adds on the HLA 1.3 side. It stands in for the
  project's real customised RPR 2.0 additions until those files arrive.

  Why a MODULE and not a modified copy of the RPR 2.0 FDD:
    * It leaves the SISO standard file untouched, so an RPR upgrade is a file swap.
    * It exercises the multi-XML path recorded in REQ-01 (HLA 1.3 gets ONE .fed;
      Evolved may take an FDD plus 0..n modules plus a MIM).

  TWO RULES, both learned the hard way against MAK RTI 5.0.1 (see vr-link-knowledge.md):

    1. A module may add NEW SUBCLASSES only - it may NOT add attributes to a class that
       another module already defines. BaseEntity therefore appears here as pure
       SCAFFOLDING (name only) and the custom attributes hang off a new subclass.
       Violating this gives: "Failed merging object classes. Object class's info for
       HLAobjectRoot.BaseEntity does not match other module".

    2. Modules must be supplied at JOIN time. Passed to createFederationExecution they are
       SILENTLY DROPPED - the federation comes up with only the first FOM and the custom
       attributes simply are not there.

  Used as:  JOIN fed=RPR_FOM_v2.0_1516-2010.xml joinfom=BTK-CustomRPR2-module.xml
  Class:    HLAobjectRoot.BaseEntity.BtkCustomEntity
-->
<objectModel xsi:schemaLocation="http://standards.ieee.org/IEEE1516-2010 http://standards.ieee.org/downloads/1516/1516.2-2010/IEEE1516-DIF-2010.xsd"
             xmlns="http://standards.ieee.org/IEEE1516-2010"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
   <modelIdentification>
      <name>BTK-CustomRPR2</name>
      <type>FOM</type>
      <version>1.0</version>
      <modificationDate>2026-08-18</modificationDate>
      <securityClassification>Unclassified</securityClassification>
      <purpose>Test fixture: custom attributes the stock RPR FOM mapper does not model.</purpose>
      <applicationDomain>All domains</applicationDomain>
      <description>Extends RPR 2.0 BaseEntity with BtkCustomValue and BtkCustomTag so the
                   BrokerTestKit can prove that unmodelled attributes survive translation
                   byte-for-byte. Mirrors the HLA 1.3 side (BTK-CustomRPR1.fed).</description>
      <useLimitation>Development and regression testing only. Not for production federations.</useLimitation>
      <poc>
         <pocType>Primary author</pocType>
         <pocName>HLAUnitTestingKit</pocName>
         <pocOrg>BrokerTestKit</pocOrg>
      </poc>
   </modelIdentification>

   <objects>
      <objectClass>
         <name>HLAobjectRoot</name>
         <objectClass>
            <name>BaseEntity</name>
            <objectClass>
               <name>BtkCustomEntity</name>
               <sharing>PublishSubscribe</sharing>
               <semantics>Scaffolded subclass carrying the BTK custom attributes.</semantics>
               <attribute>
                  <name>BtkCustomValue</name>
                  <dataType>HLAfloat64BE</dataType>
                  <updateType>Conditional</updateType>
                  <updateCondition>On change</updateCondition>
                  <ownership>DivestAcquire</ownership>
                  <sharing>PublishSubscribe</sharing>
                  <transportation>HLAbestEffort</transportation>
                  <order>Receive</order>
                  <semantics>BTK fixture: a scalar custom attribute outside the RPR mapper.</semantics>
               </attribute>
               <attribute>
                  <name>BtkCustomTag</name>
                  <dataType>HLAopaqueData</dataType>
                  <updateType>Conditional</updateType>
                  <updateCondition>On change</updateCondition>
                  <ownership>DivestAcquire</ownership>
                  <sharing>PublishSubscribe</sharing>
                  <transportation>HLAbestEffort</transportation>
                  <order>Receive</order>
                  <semantics>BTK fixture: an opaque byte-array custom attribute.</semantics>
               </attribute>
            </objectClass>
         </objectClass>
      </objectClass>
   </objects>
</objectModel>
