  ;;==========================================================================
  ;; Broker Test Kit -- RID for the HLA test harness   (MAK RTI 4.6.1, VC14)
  ;;
  ;; Point the env var RTI_CONFIG at THIS folder (the CLI does this automatically;
  ;; the POC .bat files also set it). Only harness-relevant overrides are set here;
  ;; everything else falls back to MAK RTI built-in defaults.
  ;;
  ;; Target RTI = MAK RTI 4.6.1 (VC14) -- chosen to match VR-Link 5.9 (VC14). The
  ;; VR-Exchange broker must be VC14 and use this same RTI. (RTI 4.3/4.4.2 are VC10
  ;; and are NOT compatible with VR-Link 5.9.) Use the RTI Chooser to make 4.6.1 active.
  ;;==========================================================================

  ;; The broker translates HLA 1.3 <-> HLA Evolved. Keep cross-version interop ON.
  ;; (This applies regardless of the connection-config switch below.)
(setqb RTI_extend13and1516interop 1)

  ;; Required companion to the above when running MULTIPLE HLA versions: the RTI 5.0.1
  ;; warns "RTI_extend13and1516interop is enabled and RTI_enableFomComponentSorting is
  ;; disabled ... suggested to enable sorting to overcome differences in FOM files."
  ;; We run HLA 1.3 (Fed A) + HLA Evolved (Fed B), so enable it.
(setqb RTI_enableFomComponentSorting 1)

  ;; Let the RID -- not the RTI Assistant GUI -- drive connection settings, so
  ;; headless/CI runs are deterministic and reproducible.
  ;; NOTE: with this = 1, the broker must use MATCHING connection settings
  ;; (ports / dest address below) to join the same federations.
(setqb RTI_configureConnectionWithRid 1)

  ;; ---- Connection (MAK defaults; change only to isolate from other exercises) ----
(setqb RTI_useRtiExec 0)            ;; lightweight: no rtiexec process needed
(setqb RTI_udpPort 4000)
(setqb RTI_tcpPort 4000)
(setqb RTI_destAddrString "229.7.7.7")
(setqb RTI_tcpForwarderAddr "127.0.0.1")
(setqb RTI_mcastDiscoveryEnabled 0)

  ;; We use APP-LEVEL serialization (DESIGN.md 9.1), not HLA time management, so TM
  ;; is not required. Left ON (harmless, available if a federation needs it).
(setqb RTI_timeMgmt 1)

  ;; ---- RTI Assistant: OFF ----
  ;; The harness is headless/CI. Worse, a running Assistant of a DIFFERENT RTI version
  ;; kills the federate at startup with:
  ;;   "Assistant causing connection to shutdown because: Invalid message version
  ;;    from Assistant. Disconnecting."  -> SEHException in ExerciseConnection ctor.
  ;; Turning these off stops the federate talking to the Assistant, so the harness is
  ;; immune to whichever Assistant happens to be running.
(setqb RTI_enableLRCNetworkStatisticsMonitoring 0)
(setqb RTI_enableNetworkTesting 0)

  ;; ---- Diagnostics (handy while bringing the harness up) ----
(setqb RTI_notifyLevel 2)
;; (setqb RTI_logFileName "makRti.log")     ;; uncomment to write a federate log
;; (setqb RTI_reuseLogFile 1)

  ;;==========================================================================
  ;; OPTIONAL A -- RELIABLE DELIVERY
  ;; Best-effort UDP can drop updates -> false timeouts in golden-file runs.
  ;; For guaranteed delivery, run an rtiexec per federation and enable all three:
  ;;==========================================================================
;; (setqb RTI_useRtiExec 1)
;; (setqb RTI_internalMsgReliableWhenUsingRtiexec 1)
;; (setqb RTI_fomDataTransportTypeControl 2)   ;; all FOM data reliable (needs configureConnectionWithRid 1)

  ;;==========================================================================
  ;; OPTIONAL B -- SINGLE-HOST ISOLATION (great for CI)
  ;; If harness Federate A, harness Federate B, and the broker all run on ONE
  ;; machine, use shared memory only: no network I/O, no LAN cross-talk, reliable.
  ;;==========================================================================
;; (setqb RTI_sharedMemoryMode 1)            ;; 0=off (default), 1=shm only, 2=shm+network
;; (setqb RTI_sharedMemoryName "BtkRtiShared")
