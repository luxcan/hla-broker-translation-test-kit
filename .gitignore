# Build output
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# Test/run artifacts
*.log
results/

# Native agent build output (built by src/BrokerTestKit.AgentNative/build-native.bat)
build/native/

# ---------------------------------------------------------------------------
# MAK licensed / vendor files - EXCLUDED by decision. Anyone cloning this repo
# supplies them from their own MAK install; see SETUP.md.
#
# These are redistributable only under MAK's licence, and the derived customised
# FOMs below are modified copies of MAK-shipped files, so they inherit that status.
# ---------------------------------------------------------------------------
lib/vrlink/vrLinkSharp.dll

config/MAK-RPR1-1-1.fed
config/HLAstandardMIM.xml
config/RPR_FOM_v2.0_1516-2010.xml

# Derived from MAK-shipped FOMs (see docs/FOM-HANDOVER.md)
config/BTK-CustomRPR1.fed
config/BTK-CustomRPR1.omt
config/BTK-CustomRPR2.xml


# Local Claude Code settings - machine specific
.claude/settings.local.json

# GUI workspace: the app keeps its database and imported FOMs beside the exe.
# Those are under bin/ and already ignored, but be explicit - they contain
# copies of the licensed FOMs above.
*.db
*.db-wal
*.db-shm
assets/
rti/

# ---------------------------------------------------------------------------
# EVERYTHING FOM- OR RTI-DERIVED IS EXCLUDED.
#
# Not only the FOM files themselves. A generated CSV template carries the FOM's
# attribute names, datatypes and BYTE OFFSETS; an agent script names the
# customised attributes and the .fed it joins with. That is the FOM's structure
# in another format, so it is excluded on the same grounds.
#
# The repo therefore holds CODE and DOCS. Data comes from your own install -
# see SETUP.md.
# ---------------------------------------------------------------------------

# RID files - RTI configuration, derived from MAK's shipped rids
config/*.mtl

# Every FOM, including project-authored modules
config/*.fed
config/*.omt
config/*.xml

# Test data and generated templates - carry FOM attribute names and offsets
tests/*.csv
tests/cases/
tests/templates/

# Native agent scripts - name the customised attributes and their byte values
tests/native/*.txt
