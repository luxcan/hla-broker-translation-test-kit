<UserControl x:Class="BrokerTestKit.Gui.Views.FomAddView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,22,32,32">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="FOM Registry" Style="{StaticResource LinkButton}" Click="OpenRegistry"/>
                <TextBlock Text="  /  " Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="CrumbHere" Text="Add New FOM" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="Title" Text="Add New FOM" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="Lead" Style="{StaticResource PageLead}" MaxWidth="900" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Text="Register the files once; pairs pick the FOM by name. The files are parsed and checked the moment you register, and Register returns you to the FOM Registry with the new FOM listed."/>

            <Border Style="{StaticResource Card}" Width="720" HorizontalAlignment="Left" Margin="0,18,0,0">
                <StackPanel>
                    <Label Content="Name"/>
                    <TextBox x:Name="FName"/>

                    <Label Content="HLA version"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <RadioButton x:Name="F13" Content="HLA 1.3" IsChecked="True" GroupName="FVer"
                                     Margin="0,0,18,0" Checked="FomVersionChanged"/>
                        <RadioButton x:Name="F1516" Content="HLA Evolved" GroupName="FVer" Checked="FomVersionChanged"/>
                    </StackPanel>

                    <Label x:Name="FStructLabel" Content="FED (.fed)  — what the RTI joins with"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseStruct" MinWidth="80" Margin="6,0,0,0"/>
                        <TextBox x:Name="FStruct"/>
                    </DockPanel>

                    <StackPanel x:Name="FOmtRow">
                        <Label Content="OMT (.omt)  — REQUIRED: the .fed has no datatypes"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseOmt" MinWidth="80" Margin="6,0,0,0"/>
                            <TextBox x:Name="FOmt"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel x:Name="FEvolvedRows" Visibility="Collapsed">
                        <Label Content="Join modules (comma separated — merged at JOIN)"/>
                        <TextBox x:Name="FModules"/>
                        <Label Content="MIM (optional)"/>
                        <TextBox x:Name="FMim"/>
                    </StackPanel>

                    <TextBlock x:Name="FHint" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>

                    <Border x:Name="FResultBox" Margin="0,14,0,0" Style="{StaticResource InsetCard}" Visibility="Collapsed">
                        <TextBlock x:Name="FResult" TextWrapping="Wrap" FontSize="12"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="RegisterButton" Content="Register" Click="RegisterFom" Style="{StaticResource AccentButton}" MinWidth="110"/>
                        <Button Content="Cancel" Click="OpenRegistry"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
