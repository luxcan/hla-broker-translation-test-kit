<UserControl x:Class="BrokerTestKit.Gui.Views.TestCaseResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,22,32,32">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Pairs" Style="{StaticResource LinkButton}" Click="OpenPairs"/>
                <TextBlock Text="  /  " Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Button x:Name="CrumbPair" Style="{StaticResource LinkButton}" Click="OpenPair"/>
                <TextBlock Text="  /  " Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="CrumbHere" VerticalAlignment="Center"/>
            </StackPanel>

            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="EditButton" Content="Edit test case" Click="EditCase"/>
                    <Button x:Name="StopButton" Content="Stop" Click="Stop" Visibility="Collapsed"/>
                    <Button x:Name="RunButton" Content="Run again" Style="{StaticResource AccentButton}" Click="RunAgain" Margin="0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="Title" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="Sides" Style="{StaticResource PageLead}"/>
                </StackPanel>
            </DockPanel>

            <!-- verdict strip -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="Export results…" Click="Export" VerticalAlignment="Top" Margin="0"/>
                        <StackPanel>
                            <TextBlock x:Name="Verdict" FontSize="20" Style="{StaticResource ResultLabel}"/>
                            <TextBlock x:Name="VerdictSub" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <UniformGrid Columns="5" Margin="0,14,0,0">
                        <StackPanel><TextBlock x:Name="NPass" Style="{StaticResource BigNumber}" Foreground="{DynamicResource OutcomePassText}" Text="0"/><TextBlock Text="Passed" Style="{StaticResource Muted}"/></StackPanel>
                        <StackPanel><TextBlock x:Name="NFail" Style="{StaticResource BigNumber}" Text="0"/><TextBlock Text="Failed" Style="{StaticResource Muted}"/></StackPanel>
                        <StackPanel><TextBlock x:Name="NTimeout" Style="{StaticResource BigNumber}" Text="0"/><TextBlock Text="Timed out" Style="{StaticResource Muted}"/></StackPanel>
                        <StackPanel><TextBlock x:Name="P50" Style="{StaticResource BigNumber}" Text="—"/><TextBlock Text="Latency p50" Style="{StaticResource Muted}"/></StackPanel>
                        <StackPanel><TextBlock x:Name="P95" Style="{StaticResource BigNumber}" Text="—"/><TextBlock Text="Latency p95" Style="{StaticResource Muted}"/></StackPanel>
                    </UniformGrid>
                    <TextBlock x:Name="ClassLine" Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="AbortLine" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ValidationError}" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16" MinHeight="320">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Rows" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="RowsGrid" Style="{StaticResource ListGrid}" MaxHeight="460"
                                  RowStyle="{StaticResource OutcomeRows}" SelectionChanged="RowSelected">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Step}" Width="44"/>
                                <DataGridTextColumn Header="Entity" Binding="{Binding EntityId}" Width="*"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding Outcome}" Width="80"/>
                                <DataGridTextColumn Header="Fields" Binding="{Binding FieldsText}" Width="70"/>
                                <DataGridTextColumn Header="Latency" Binding="{Binding Latency}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="FieldTitle" Text="Field comparison" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                        <TextBlock DockPanel.Dock="Top" x:Name="RowMessage" Style="{StaticResource Muted}" Margin="0,0,0,8"
                                   Text="Select a row to see what was expected and what arrived."/>
                        <ItemsControl DockPanel.Dock="Top" x:Name="PartsList" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Outcome}" Tag="{Binding OutcomeName}" Style="{StaticResource ResultLabel}" Width="64"/>
                                        <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding EntityId}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DataGrid x:Name="FieldsGrid" Style="{StaticResource ListGrid}" RowStyle="{StaticResource FieldRows}" MaxHeight="400">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="2.2*"/>
                                <DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="*"/>
                                <DataGridTextColumn Header="Received" Binding="{Binding Actual}" Width="*"/>
                                <DataGridTextColumn Header="" Binding="{Binding Ok}" Width="34"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="1.2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <Expander x:Name="TranscriptBox" Header="Agent transcript — what actually went on the wire" Margin="0,0,0,16"
                      Foreground="{DynamicResource TextPrimary}">
                <TextBox x:Name="LogBox" Style="{StaticResource Mono}" Height="220" Margin="0,8,0,0"/>
            </Expander>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Runs of this test case" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                    <DataGrid x:Name="HistoryGrid" Style="{StaticResource ListGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding When}" Width="140"/>
                            <DataGridTemplateColumn Header="Result" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ResultText}" Tag="{Binding Result}" Style="{StaticResource ResultLabel}"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100"/>
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View" Style="{StaticResource LinkButton}" Click="ViewRun" Margin="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="NoHistory" Style="{StaticResource Muted}" Visibility="Collapsed" Text="Not run yet."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
