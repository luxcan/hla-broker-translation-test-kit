<UserControl x:Class="BrokerTestKit.Gui.Views.AllResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,22,32,24">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Dashboard" Style="{StaticResource LinkButton}" Click="OpenDashboard"/>
                <TextBlock Text="  /  " Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock Text="All results" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="All results" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="Every saved run, newest first."/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,14">
                <StackPanel Margin="0,0,16,0">
                    <Label Content="Pair"/>
                    <ComboBox x:Name="PairFilter" Width="260" Height="30" SelectionChanged="FilterChanged"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <Label Content="Result"/>
                    <ComboBox x:Name="ResultFilter" Width="150" Height="30" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="Any result" Tag="" IsSelected="True"/>
                        <ComboBoxItem Content="Pass" Tag="Pass"/>
                        <ComboBoxItem Content="Fail" Tag="Fail"/>
                        <ComboBoxItem Content="Timed out" Tag="Timeout"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <Label Content="Test case"/>
                    <TextBox x:Name="TextFilter" Width="240" TextChanged="TextChanged"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock x:Name="TallyText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Count" Style="{StaticResource CardTitle}"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="PrevButton" Content="Previous" Click="Prev"/>
                        <Button x:Name="NextButton" Content="Next" Click="Next" Margin="0"/>
                    </StackPanel>
                    <TextBlock x:Name="PageText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid x:Name="RunsGrid" Style="{StaticResource ListGrid}" MouseDoubleClick="RowDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding When}" Width="130"/>
                        <DataGridTemplateColumn Header="Pair" Width="1.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding PairDisplay}" Style="{StaticResource LinkButton}" Click="OpenPair" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Test case" Binding="{Binding TestCaseDisplay}" Width="1.4*"/>
                        <DataGridTemplateColumn Header="Result" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ResultText}" Tag="{Binding Result}" Style="{StaticResource ResultLabel}"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Latency p50" Binding="{Binding LatencyText}" Width="100"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="90"/>
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Open" Style="{StaticResource LinkButton}" Click="OpenRun" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
