<UserControl x:Class="BrokerTestKit.Gui.Views.PairsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,26,32,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Pairs" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageLead}" MaxWidth="900" HorizontalAlignment="Left"
                       Text="A pair is one broker crossing: what you Send on federation A and where B must Receive it. Each direction is its own pair, with its own test cases."/>
            <DockPanel Margin="0,14,0,0" Width="380" HorizontalAlignment="Left">
                <TextBlock Text="Find a pair" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Name, FOM or RTI"
                         AutomationProperties.Name="Find a pair"/>
            </DockPanel>
        </StackPanel>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="+ New pair" Style="{StaticResource LinkButton}" Click="NewPair" Margin="0,12,0,0"/>
                <TextBlock DockPanel.Dock="Bottom" x:Name="EmptyText" Style="{StaticResource Muted}" Margin="0,10,0,0"
                           Visibility="Collapsed" Text="No pairs yet. Create one to start adding test cases."/>
                <DataGrid x:Name="PairsGrid" Style="{StaticResource ListGrid}" MouseDoubleClick="RowDoubleClick" RowHeight="44">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Pair" Width="1.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Style="{StaticResource LinkButton}" Click="OpenPair" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Send · A" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SendFom}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SendWhere}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="" Binding="{Binding Arrow}" Width="30"/>
                        <DataGridTemplateColumn Header="Receive · B" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ReceiveFom}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ReceiveWhere}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Test cases" Binding="{Binding TestCases}" Width="90"/>
                        <DataGridTemplateColumn Header="Last run" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastResult}" Tag="{Binding LastTag}" Style="{StaticResource ResultLabel}"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="When" Binding="{Binding When}" Width="130"/>
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Open" Style="{StaticResource LinkButton}" Click="OpenPair" Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
