<UserControl x:Class="BrokerTestKit.Gui.Views.FomRegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Content="+ Add New FOM" Style="{StaticResource AccentButton}"
                    Click="AddFom" VerticalAlignment="Top" Margin="0"/>
            <StackPanel>
                <TextBlock Text="FOM Registry" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageLead}" MaxWidth="900" HorizontalAlignment="Left"
                           Text="Every FOM a pair can use. Register the files once; pairs pick them by name and the CSV template reads their classes."/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Update" Click="UpdateFom"/>
                        <Button Content="Re-check all" Click="RecheckAll"/>
                        <Button Content="Remove" Click="RemoveFom" Margin="0"/>
                    </StackPanel>
                    <TextBlock x:Name="Count" Text="Registered FOMs" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,10,0,0"
                           Text="A FOM used by a pair can't be removed - change or delete those pairs first. Double-click a FOM to point it at new files."/>
                <TextBlock x:Name="NoFoms" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed"
                           Text="No FOMs registered yet. Add New FOM registers the files a federation speaks: the .fed and .omt for HLA 1.3, or the FDD and its modules for HLA Evolved."/>
                <DataGrid x:Name="FomList" Style="{StaticResource ListGrid}" MouseDoubleClick="RowDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*"/>
                        <DataGridTextColumn Header="HLA" Binding="{Binding Version}" Width="Auto"/>
                        <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="1.5*"/>
                        <DataGridTextColumn Header="Contents" Binding="{Binding Status}" Width="1.8*"/>
                        <DataGridTextColumn Header="Used by" Binding="{Binding UsedByText}" Width="80"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource OutcomeWarnRow}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
