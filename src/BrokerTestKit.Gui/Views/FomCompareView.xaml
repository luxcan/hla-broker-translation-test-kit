<UserControl x:Class="BrokerTestKit.Gui.Views.FomCompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Differs is the row to look at; one-sided rows are information, not faults. -->
        <Style x:Key="DiffRows" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding KindText}" Value="Differs"><Setter Property="Background" Value="{DynamicResource OutcomeWarnRow}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MemberRows" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource DiffRows}">
            <Setter Property="ToolTip" Value="{Binding WireText}" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="32,22,32,24">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Pairs" Style="{StaticResource LinkButton}" Click="OpenPairs"/>
                <TextBlock Text="  /  " Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Button x:Name="CrumbPair" Style="{StaticResource LinkButton}" Click="OpenPair"/>
                <TextBlock Text="  /  " Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock Text="Compare FOMs" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Compare FOMs" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="Lead" Style="{StaticResource PageLead}" TextWrapping="Wrap"/>
            <TextBlock x:Name="Problem" Style="{StaticResource Muted}" Foreground="{DynamicResource ValidationError}"
                       Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,14">
                <StackPanel Margin="0,0,16,0">
                    <Label Content="Show"/>
                    <ComboBox x:Name="KindFilter" Width="190" Height="30" SelectionChanged="FilterChanged">
                        <ComboBoxItem Content="Every class" Tag="" IsSelected="True"/>
                        <ComboBoxItem Content="On both sides" Tag="Matched"/>
                        <ComboBoxItem Content="Layout differs" Tag="Differs"/>
                        <ComboBoxItem Content="Partial (extra members)" Tag="Partial"/>
                        <ComboBoxItem Content="Only on A" Tag="OnlyA"/>
                        <ComboBoxItem Content="Only on B" Tag="OnlyB"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <Label Content="Class or interaction"/>
                    <TextBox x:Name="TextFilter" Width="240" TextChanged="TextChanged"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock x:Name="Count" DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                    <DataGrid x:Name="ClassGrid" Style="{StaticResource ListGrid}" RowStyle="{StaticResource DiffRows}"
                              SelectionMode="Single" SelectionChanged="ClassSelected"
                              AutomationProperties.Name="Classes">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding KindText}" Width="92"/>
                            <DataGridTextColumn Header="Class or interaction" Binding="{Binding Display}" Width="1*"/>
                            <DataGridTextColumn Header="Members" Binding="{Binding Summary}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <DockPanel>
                            <Button x:Name="CreateButton" DockPanel.Dock="Right" Content="Create test case from this class"
                                    Style="{StaticResource AccentButton}" Click="CreateTestCase" Margin="0" IsEnabled="False"/>
                            <TextBlock x:Name="DetailTitle" Style="{StaticResource CardTitle}" Text="Pick a class"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock x:Name="DetailNames" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailHint" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DataGrid x:Name="MemberGrid" Style="{StaticResource ListGrid}" RowStyle="{StaticResource MemberRows}"
                              AutomationProperties.Name="Members">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding KindText}" Width="92"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.3*"/>
                            <DataGridTextColumn Header="Type on A" Binding="{Binding TypeA}" Width="1.2*"/>
                            <DataGridTextColumn Header="Type on B" Binding="{Binding TypeB}" Width="1.2*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
