<UserControl x:Class="BrokerTestKit.Gui.Views.PairEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- sticky footer -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource FooterBar}">
            <DockPanel>
                <Button x:Name="DeleteButton" DockPanel.Dock="Left" Content="Delete pair…" Style="{StaticResource DangerButton}"
                        Click="DeletePair" Height="36"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel" Height="36"/>
                    <Button Content="Save pair" Style="{StaticResource AccentButton}" Click="Save" Height="36" Margin="0" MinWidth="120"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,22,32,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Pairs" Style="{StaticResource LinkButton}" Click="OpenPairs"/>
                    <TextBlock x:Name="CrumbSep" Text="  /  " Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <Button x:Name="CrumbPair" Style="{StaticResource LinkButton}" Click="OpenPair"/>
                    <TextBlock Text="  /  " Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CrumbHere" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="Title" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageLead}" MaxWidth="900" HorizontalAlignment="Left" Margin="0,4,0,18"
                           Text="Which FOM each side speaks and which RTI carries it. The broker sits between them and translates; the test kit joins both federations to check it."/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Label Content="Pair name" Padding="0,0,0,4"/>
                        <TextBox x:Name="PairName" TextChanged="NameTyped" MaxWidth="560" HorizontalAlignment="Left" Width="560"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Suggested from the two FOMs; type over it freely."/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===================== SEND · A ===================== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                                    <TextBlock x:Name="AHla" FontSize="11"/>
                                </Border>
                                <TextBlock Text="Send · A" Style="{StaticResource CardTitle}"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="Manage FOMs" Style="{StaticResource LinkButton}" Click="ManageFoms"/>
                                <Label Content="FOM — from the registry"/>
                            </DockPanel>
                            <ComboBox x:Name="AFom" DisplayMemberPath="Name" Height="30" SelectionChanged="FomChanged"/>
                            <Label Content="Federation (exec) name"/>
                            <TextBox x:Name="AExec"/>
                            <Label Content="Federate name"/>
                            <TextBox x:Name="AFederate"/>
                            <TextBlock Text="RTI" Style="{StaticResource Overline}" Margin="0,14,0,0"/>
                            <Label Content="RTI install — bin folder"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Tag="ABin" Click="BrowseFolder" MinWidth="80" Margin="6,0,0,0"/>
                                <TextBox x:Name="ABin" TextChanged="RtiChanged"/>
                            </DockPanel>
                            <Label Content="RID file (rid.mtl)"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Tag="ARid" Click="BrowseRid" MinWidth="80" Margin="6,0,0,0"/>
                                <TextBox x:Name="ARid"/>
                            </DockPanel>
                            <Label Content="FOM search folder (RTI__CONFIG) — blank = the RID file's folder"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse…" Tag="AConfig" Click="BrowseFolder" MinWidth="80" Margin="6,0,0,0"/>
                                <TextBox x:Name="AConfig"/>
                            </DockPanel>
                            <Label Content="RTI Assistant port — must differ from the other side"/>
                            <TextBox x:Name="APort" Width="120" HorizontalAlignment="Left" TextChanged="RtiChanged"/>
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Content="Re-check" Style="{StaticResource LinkButton}" Click="Recheck"/>
                                <TextBlock x:Name="AStatus" Style="{StaticResource Muted}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0" Width="90">
                        <TextBlock x:Name="ArrowText" Text="VR-Exchange 2.9 translates" Style="{StaticResource Muted}"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="→" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBackground}"/>
                    </StackPanel>

                    <!-- ===================== RECEIVE · B ===================== -->
                    <Border Grid.Column="2" x:Name="BCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                                    <TextBlock x:Name="BHla" FontSize="11"/>
                                </Border>
                                <TextBlock Text="Receive · B" Style="{StaticResource CardTitle}"/>
                            </DockPanel>
                            <TextBlock x:Name="SelfTestNote" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed"
                                       Text="Self-test: both agents join A's federation and the sheets are checked with an identity mapping. B is not used."/>
                            <StackPanel x:Name="BFields">
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Content="Manage FOMs" Style="{StaticResource LinkButton}" Click="ManageFoms"/>
                                    <Label Content="FOM — from the registry"/>
                                </DockPanel>
                                <ComboBox x:Name="BFom" DisplayMemberPath="Name" Height="30" SelectionChanged="FomChanged"/>
                                <Label Content="Federation (exec) name"/>
                                <TextBox x:Name="BExec"/>
                                <Label Content="Federate name"/>
                                <TextBox x:Name="BFederate"/>
                                <TextBlock Text="RTI" Style="{StaticResource Overline}" Margin="0,14,0,0"/>
                                <Label Content="RTI install — bin folder"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse…" Tag="BBin" Click="BrowseFolder" MinWidth="80" Margin="6,0,0,0"/>
                                    <TextBox x:Name="BBin" TextChanged="RtiChanged"/>
                                </DockPanel>
                                <Label Content="RID file (rid.mtl)"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse…" Tag="BRid" Click="BrowseRid" MinWidth="80" Margin="6,0,0,0"/>
                                    <TextBox x:Name="BRid"/>
                                </DockPanel>
                                <Label Content="FOM search folder (RTI__CONFIG) — blank = the RID file's folder"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse…" Tag="BConfig" Click="BrowseFolder" MinWidth="80" Margin="6,0,0,0"/>
                                    <TextBox x:Name="BConfig"
                                             ToolTip="For an Evolved side joining with the VR-Exchange broker's FOM modules this must be the broker's own bin64 folder."/>
                                </DockPanel>
                                <Label Content="RTI Assistant port — must differ from the other side"/>
                                <TextBox x:Name="BPort" Width="120" HorizontalAlignment="Left" TextChanged="RtiChanged"/>

                                <Border x:Name="JoinBox" Style="{StaticResource InsetCard}" Margin="0,14,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Edit list" Style="{StaticResource LinkButton}" Click="ManageFoms"/>
                                            <TextBlock Text="Join modules" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <TextBlock x:Name="JoinText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Foreground="{DynamicResource OutcomeWarnText}"
                                                   Text="Without them B joins cleanly and receives nothing."/>
                                    </StackPanel>
                                </Border>

                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" Content="Re-check" Style="{StaticResource LinkButton}" Click="Recheck"/>
                                    <TextBlock x:Name="BStatus" Style="{StaticResource Muted}"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="PortLine" Margin="0,12,0,0" TextWrapping="Wrap"/>

                <Expander Header="Advanced" Margin="0,16,0,0" Foreground="{DynamicResource TextPrimary}">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel>
                            <CheckBox x:Name="SelfTest" Content="Self-test — both agents on A, identity mapping (no broker)"
                                      Checked="SelfTestChanged" Unchecked="SelfTestChanged"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="22,2,0,12"
                                       Text="Proves the rig without the broker. Any failure is the harness's fault, not the broker's."/>
                            <Label Content="Licence server (shared by every pair)"/>
                            <TextBox x:Name="Licence" Width="260" HorizontalAlignment="Left" ToolTip="FlexLM, e.g. 27000@127.0.0.1"/>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
