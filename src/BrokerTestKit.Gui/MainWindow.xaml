<Window x:Class="BrokerTestKit.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HLA Broker Translation Test Kit" Height="900" Width="1440" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!-- ================================================================= status -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBackground}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Ready." Margin="14,5" FontSize="12" MinHeight="18"
                       Foreground="{DynamicResource StatusBarForeground}" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- =============================================================== sidebar -->
        <Border DockPanel.Dock="Left" Width="248" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource AppBackground}"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource AccentBackground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="HLA Broker Translation Test Kit" FontWeight="SemiBold" TextWrapping="Wrap"
                               Width="170" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- run box, bottom -->
                <Button DockPanel.Dock="Bottom" x:Name="RunBox" Click="RunBoxClicked" Margin="0,14,0,0"
                        Style="{StaticResource CardButton}"
                        AutomationProperties.Name="Test run status">
                    <StackPanel>
                        <DockPanel>
                            <Border x:Name="RunBadge" DockPanel.Dock="Right" Style="{StaticResource Badge}"
                                    Background="{StaticResource IdleBadgeBackground}">
                                <TextBlock x:Name="RunBadgeText" Text="Idle" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                            <TextBlock Text="Test run" Style="{StaticResource Muted}"/>
                        </DockPanel>
                        <StackPanel x:Name="RunIdle" Margin="0,8,0,0">
                            <TextBlock Text="No test running" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                       Text="Runs you start from a pair show their progress here."/>
                        </StackPanel>
                        <StackPanel x:Name="RunLive" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="RunPair" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="RunCase" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="RunProgress" Height="6" Margin="0,8,0,6" Minimum="0" Maximum="1"
                                         Foreground="{DynamicResource AccentBackground}"
                                         Background="{DynamicResource Divider}" BorderThickness="0"/>
                            <DockPanel>
                                <TextBlock x:Name="RunFail" DockPanel.Dock="Right" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="RunPass" DockPanel.Dock="Right" Margin="0,0,10,0" FontSize="12"
                                           Foreground="{DynamicResource AccentBackground}"/>
                                <TextBlock x:Name="RunRows" FontSize="12"/>
                            </DockPanel>
                            <TextBlock x:Name="RunNext" Style="{StaticResource Muted}" Margin="0,8,0,0"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="TOOLS" Style="{StaticResource Overline}" Margin="8,0,0,6"/>
                    <ListBox x:Name="ToolsNav" Style="{StaticResource NavList}" Padding="0"
                             ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="ToolsNavChanged">
                        <ListBoxItem Content="CSV template" Tag="&#xE8A5;"/>
                        <ListBoxItem Content="FOM registry" Tag="&#xE8F1;"/>
                    </ListBox>
                </StackPanel>

                <ListBox x:Name="MainNav" Style="{StaticResource NavList}" Padding="0" VerticalAlignment="Top"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="MainNavChanged">
                    <ListBoxItem Content="Dashboard" Tag="&#xE80F;"/>
                    <ListBoxItem Content="Pairs" Tag="&#xE8AB;"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================================ main area -->
        <DockPanel Background="{DynamicResource AppBackground}">
            <Border x:Name="BannerBox" DockPanel.Dock="Top" Style="{StaticResource Banner}" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Check again" Style="{StaticResource LinkButton}"
                            Click="RecheckRig" Margin="16,0,0,0"/>
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource OutcomeWarnText}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <ContentControl x:Name="Host" Focusable="False"/>
        </DockPanel>
    </DockPanel>
</Window>
