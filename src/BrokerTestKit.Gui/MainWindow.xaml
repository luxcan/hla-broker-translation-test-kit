<Window x:Class="BrokerTestKit.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HLA Broker Test Kit" Height="860" Width="1400"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!-- ================================================================= status -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBackground}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
            <Grid Margin="14,5" MinHeight="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready." VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource StatusBarForeground}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" x:Name="SummaryText" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
            </Grid>
        </Border>

        <!-- =============================================================== side nav -->
        <Border DockPanel.Dock="Left" Width="220"
                Background="{DynamicResource SurfaceAltBackground}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,16,16,13"
                        BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Broker Test Kit" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="HLA 1.3  →  HLA Evolved" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Border>

                <ListBox x:Name="Nav" Style="{StaticResource NavList}"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="NavChanged">
                    <ListBoxItem Content="FOM registry"  Tag="&#xE8F1;"/>
                    <ListBoxItem Content="Connections"   Tag="&#xE713;"/>
                    <ListBoxItem Content="CSV template"  Tag="&#xE8A5;"/>
                    <ListBoxItem Content="Test data"     Tag="&#xE8FD;"/>
                    <ListBoxItem Content="Run"           Tag="&#xE768;"/>
                </ListBox>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Style="{StaticResource NavHost}">

            <!-- ========================================================= FOM REGISTRY -->
            <TabItem Header="FOM registry">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="FOM registry" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Style="{StaticResource Hint}" MaxWidth="900" HorizontalAlignment="Left">
                            Register each FOM once and the federations refer to it by name. Files are parsed
                            and checked the moment you register, so a missing .omt or a malformed FDD is
                            reported here rather than halfway through a test run.
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="400"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Registered FOMs">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Re-check" Click="RecheckFom"/>
                                    <Button Content="Remove" Click="RemoveFom"/>
                                </StackPanel>
                                <DataGrid x:Name="FomList" IsReadOnly="True" SelectionChanged="FomSelected">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.4*"/>
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="Auto"/>
                                        <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="1.6*"/>
                                        <DataGridTextColumn Header="Contents" Binding="{Binding Status}" Width="1.8*"/>
                                    </DataGrid.Columns>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource OutcomeFailRow}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="Add / edit">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Label Content="Name"/>
                                    <TextBox x:Name="FName"/>

                                    <Label Content="HLA version"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                        <RadioButton x:Name="F13" Content="HLA 1.3" IsChecked="True"
                                                     GroupName="FVer" Margin="0,0,18,0"
                                                     Checked="FomVersionChanged"/>
                                        <RadioButton x:Name="F1516" Content="HLA Evolved"
                                                     GroupName="FVer" Checked="FomVersionChanged"/>
                                    </StackPanel>

                                    <Label x:Name="FStructLabel" Content="FED (.fed)  — what the RTI joins with"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseStruct" MinWidth="80"/>
                                        <TextBox x:Name="FStruct"/>
                                    </DockPanel>

                                    <StackPanel x:Name="FOmtRow">
                                        <Label Content="OMT (.omt)  — REQUIRED: the .fed has no datatypes"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseOmt" MinWidth="80"/>
                                            <TextBox x:Name="FOmt"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="FEvolvedRows" Visibility="Collapsed">
                                        <Label Content="Extra FOM modules (comma separated — merged at JOIN)"/>
                                        <TextBox x:Name="FModules"/>
                                        <Label Content="MIM (optional)"/>
                                        <TextBox x:Name="FMim"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Register" Click="RegisterFom"
                                                Style="{StaticResource AccentButton}" MinWidth="110"/>
                                        <Button Content="Clear" Click="ClearFomForm"/>
                                    </StackPanel>

                                    <Border x:Name="FResultBox" Margin="0,14,0,0" Padding="11,9"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Background="{DynamicResource ControlBackground}"
                                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="FResult" TextWrapping="Wrap" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================================== FEDERATIONS -->
            <TabItem Header="Federations">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="RTI connections" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Style="{StaticResource Hint}" MaxWidth="900" HorizontalAlignment="Left">
                            One entry per way into a federation: which FOM it speaks, which RTI carries it,
                            which execution to join. A federation execution is created WITH a FOM, so the two
                            belong together — and naming the FOM here also settles the HLA version, and with
                            it which agent binary runs. A test run then picks two connections, source and
                            target, instead of filling in eight fields.
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="430"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Registered connections">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Re-check" Click="RecheckConn"/>
                                    <Button Content="Remove" Click="RemoveConn"/>
                                    <Button Content="Import bridge profile…" Click="ImportProfile"
                                            ToolTip="Build both federations from a .profile file — the same file the CLI runs from, so the rig the operator sees is the rig CI proves."/>
                                </StackPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <TextBlock Text="Licence server (shared)" DockPanel.Dock="Left"
                                               VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <Button DockPanel.Dock="Right" Content="Save" Click="SaveSettings" MinWidth="80"/>
                                    <TextBox x:Name="Licence" ToolTip="FlexLM, e.g. 27000@127.0.0.1"/>
                                </DockPanel>
                                <DataGrid x:Name="ConnList" IsReadOnly="True" SelectionChanged="ConnSelected">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Connection" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="FOM" Binding="{Binding FomName}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Execution · RTI" Binding="{Binding Where}" Width="1.1*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.5*"/>
                                    </DataGrid.Columns>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource OutcomeFailRow}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="Add / edit">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Label Content="FOM  — from the registry"/>
                                    <ComboBox x:Name="CFom" DisplayMemberPath="Name" Height="30"
                                              SelectionChanged="ConnFomChanged"/>

                                    <Label Content="Connection name"/>
                                    <TextBox x:Name="CName" ToolTip="Suggested from the FOM and RTI; type over it freely."/>

                                    <Label Content="Federation (exec) name  — the execution to create or join"/>
                                    <TextBox x:Name="CExec"/>

                                    <Label Content="Federate name"/>
                                    <TextBox x:Name="CFederate"/>

                                    <Separator Margin="0,14,0,6"/>
                                    <TextBlock Text="RTI" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Style="{StaticResource Hint}">
                                        The RID file decides WHICH RTI this federate joins — ports, multicast
                                        address, forwarder. The bin folder selects the install, and each agent
                                        is its own process, so two connections can use two different installs.
                                    </TextBlock>

                                    <Label Content="RID file (rid.mtl)"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseCRid" MinWidth="80"/>
                                        <TextBox x:Name="CRid"/>
                                    </DockPanel>

                                    <Label Content="RTI install — bin folder"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseCRtiBin" MinWidth="80"/>
                                        <TextBox x:Name="CRtiBin" TextChanged="ConnRtiChanged"/>
                                    </DockPanel>

                                    <Label Content="FOM search folder (RTI_CONFIG) — blank = the RID file's folder"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseCConfig" MinWidth="80"/>
                                        <TextBox x:Name="CConfigDir"
                                                 ToolTip="Where the agent resolves FOM file NAMES. For an Evolved side that joins with the VR-Exchange broker's FOM modules this must be the broker's own bin64 folder, or the modules do not resolve and the federate joins and then sees nothing."/>
                                    </DockPanel>

                                    <Label Content="RTI Assistant port  — must differ per RTI version"/>
                                    <TextBox x:Name="CAsstPort"
                                             ToolTip="RTI_ASSISTANT_PORT. Default 6003. Two RTI versions sharing one port means the second is dropped with &quot;Invalid message version from Assistant&quot;."/>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="Save connection" Click="SaveConn"
                                                Style="{StaticResource AccentButton}" MinWidth="130"/>
                                        <Button Content="Clear" Click="ClearConnForm"/>
                                    </StackPanel>

                                    <Border x:Name="CResultBox" Margin="0,14,0,0" Padding="11,9"
                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Background="{DynamicResource ControlBackground}"
                                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="CResult" TextWrapping="Wrap" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================================= CSV TEMPLATE -->
            <TabItem Header="CSV template">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="FOM → CSV template" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Style="{StaticResource Hint}" MaxWidth="1000" HorizontalAlignment="Left">
                            Pick an object class or an interaction, tick what the test touches, then download
                            the template. Columns and datatypes come from the FOM — the CSV never states a type,
                            so it cannot drift out of step with the FOM. Fill it in, then open it on the
                            Test data screen as the input or the expected sheet.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="From" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="TemplateFom" DisplayMemberPath="Name" Width="260" Height="30"
                                      SelectionChanged="TemplateFomChanged"/>
                            <TextBlock x:Name="FomSummary" VerticalAlignment="Center" Margin="14,0,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Classes and interactions">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Top" x:Name="FilterBox" TextChanged="FilterChanged"
                                         ToolTip="Filter by name" Margin="0,0,0,6"/>
                                <ListBox x:Name="ClassList" DisplayMemberPath="Display"
                                         SelectionChanged="ClassSelected"/>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="Attributes / parameters">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="All" Click="PickAll" MinWidth="56"/>
                                    <Button Content="None" Click="PickNone" MinWidth="56"/>
                                </StackPanel>
                                <DataGrid x:Name="MemberGrid" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
                                        <DataGridTextColumn Header="FOM datatype" Binding="{Binding DataType}" IsReadOnly="True" Width="2*"/>
                                        <DataGridTextColumn Header="Resolved" Binding="{Binding Resolved}" IsReadOnly="True" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="4" Header="Generate">
                            <StackPanel>
                                <Label Content="Rows to pre-create"/>
                                <TextBox x:Name="RowCount" Text="5"/>
                                <Label Content="Default tolerance for float columns"/>
                                <TextBox x:Name="TolBox" Text="0.001"/>
                                <Button Content="Download template…" Click="DownloadTemplate"
                                        Margin="0,14,0,8" Style="{StaticResource AccentButton}"/>
                                <Button Content="Preview template text" Click="PreviewTemplate"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0">
                                    Structs expand to their addressable leaf fields. The resolved offset and
                                    size are written in as comments so the mapping can be audited, and the
                                    tolerance line is included so the same file works as either sheet.
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- =========================================================== TEST DATA -->
            <TabItem Header="Test data">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Test data" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Style="{StaticResource Hint}" MaxWidth="1000" HorizontalAlignment="Left">
                            One row per entity or interaction. Edit here rather than in Excel, which silently
                            strips the leading zeros from hex ids and can turn values into dates.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Open input…" Click="OpenInput"/>
                            <Button Content="Open expected…" Click="OpenExpected"/>
                            <Button Content="Add row" Click="AddRow"/>
                            <Button Content="Save both" Click="SaveBoth" Style="{StaticResource AccentButton}"/>
                            <TextBlock x:Name="SheetInfo" VerticalAlignment="Center" Margin="14,0,0,0"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="INPUT  ·  published on Federation A">
                        <DataGrid x:Name="InputGrid" AutoGenerateColumns="True" CanUserAddRows="True" IsReadOnly="False"
                                  AutoGeneratingColumn="CsvColumnGenerated"/>
                    </GroupBox>

                    <GroupBox Grid.Row="3" Header="EXPECTED  ·  what Federation B must show. Empty cell = do not check.">
                        <DataGrid x:Name="ExpectedGrid" AutoGenerateColumns="True" CanUserAddRows="True" IsReadOnly="False"
                                  AutoGeneratingColumn="CsvColumnGenerated"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ================================================================= RUN -->
            <TabItem Header="Run">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="210"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Run" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <Grid Margin="0,10,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="A  ·  source — test data is pumped in here" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox x:Name="ConnA" DisplayMemberPath="Name" Height="30" Margin="0,4,0,0"
                                          SelectionChanged="ConnPickChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="B  ·  target — the broker's output is verified here" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox x:Name="ConnB" DisplayMemberPath="Name" Height="30" Margin="0,4,0,0"
                                          SelectionChanged="ConnPickChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="RunWarning" Style="{StaticResource Hint}" Visibility="Collapsed"
                                   MaxWidth="1000" HorizontalAlignment="Left" Margin="0,0,0,6"
                                   Foreground="{DynamicResource ValidationError}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                            <Button x:Name="RunButton" Content="Run test" Click="RunTest"
                                    Style="{StaticResource AccentButton}" MinWidth="120"/>
                            <Button x:Name="StopButton" Content="Stop" Click="StopTest" IsEnabled="False"/>
                            <CheckBox x:Name="SelfTest" Content="Self-test — both agents on connection A, identity mapping"
                                      VerticalAlignment="Center" Margin="16,0,0,0"
                                      ToolTip="Proves the rig without the broker. Any failure is the harness's fault."/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Rows">
                            <DataGrid x:Name="ResultGrid" IsReadOnly="True" SelectionChanged="ResultSelected">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Step}" Width="40"/>
                                    <DataGridTextColumn Header="Id" Binding="{Binding EntityId}" Width="96"/>
                                    <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="80"/>
                                    <DataGridTextColumn Header="s" Binding="{Binding Seconds, StringFormat=F2}" Width="50"/>
                                    <DataGridTextColumn Header="broker ms" Binding="{Binding Latency}" Width="76"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Outcome}" Value="Pass">
                                                <Setter Property="Background" Value="{DynamicResource OutcomePassRow}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Outcome}" Value="Fail">
                                                <Setter Property="Background" Value="{DynamicResource OutcomeFailRow}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Outcome}" Value="Timeout">
                                                <Setter Property="Background" Value="{DynamicResource OutcomeWarnRow}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="Field-level diff for the selected row">
                            <DataGrid x:Name="FieldGrid" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Ok}" Width="52"/>
                                    <DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="*"/>
                                    <DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="*"/>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="1.4*"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="FAIL">
                                                <Setter Property="Background" Value="{DynamicResource OutcomeFailRow}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </GroupBox>
                    </Grid>

                    <GroupBox Grid.Row="3" Header="Agent transcript  ·  what actually went on the wire">
                        <TextBox x:Name="LogBox" Style="{StaticResource Mono}"/>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
