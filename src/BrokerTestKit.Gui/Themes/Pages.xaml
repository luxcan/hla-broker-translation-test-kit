<!--
    Page-level styles for the Dashboard → Pairs → Test cases → Result shell (PRP gui-redesign).
    Token keys only (dark theme tokens, no hard-coded hex beyond the app's semantic outcome tints,
    which Controls.xaml already defines the same way).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BannerBackground" Color="#33DCA45C" />
    <SolidColorBrush x:Key="BannerBorder" Color="#99DCA45C" />
    <SolidColorBrush x:Key="RunningBadgeBackground" Color="#3337B6D8" />
    <SolidColorBrush x:Key="IdleBadgeBackground" Color="#332D3641" />

    <!-- ============================================================ layout ===== -->

    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,16" />
    </Style>

    <Style x:Key="InsetCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="FooterBar" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="32,12" />
    </Style>

    <Style x:Key="Banner" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BannerBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource BannerBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="32,10" />
    </Style>

    <!-- ============================================================== text ===== -->

    <Style x:Key="PageTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageLead" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Muted" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Overline" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BigNumber" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Pass / Fail / Timeout colouring, keyed on Tag so the text itself can say more. -->
    <Style x:Key="ResultLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Pass"><Setter Property="Foreground" Value="{DynamicResource OutcomePassText}" /></Trigger>
            <Trigger Property="Tag" Value="Fail"><Setter Property="Foreground" Value="{DynamicResource OutcomeFailText}" /></Trigger>
            <Trigger Property="Tag" Value="Timeout"><Setter Property="Foreground" Value="{DynamicResource OutcomeWarnText}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ buttons ==== -->

    <!-- Text that navigates. A real Button, so Tab reaches it and Enter activates it. -->
    <Style x:Key="LinkButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource AccentBackground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Ring" BorderThickness="0,0,0,1" BorderBrush="Transparent" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="False">
                            <!-- The app-wide implicit TextBlock style sets TextPrimary, which beats an
                                 inherited foreground; re-point it at the button's own. -->
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBackground}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBackground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A whole card that is clickable: the sidebar run box. -->
    <Style x:Key="CardButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Back" Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource Divider}"
                            BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource ControlBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource AccentBackground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource ValidationError}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ValidationError}" />
    </Style>

    <Style x:Key="DashedButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- A class chip: name plus a remove button. -->
    <Style x:Key="Chip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,4,4,4" />
        <Setter Property="Margin" Value="0,0,8,6" />
    </Style>

    <Style x:Key="Badge" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================ grids ====== -->

    <Style x:Key="OutcomeRows" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Outcome}" Value="Pass"><Setter Property="Background" Value="{DynamicResource OutcomePassRow}" /></DataTrigger>
            <DataTrigger Binding="{Binding Outcome}" Value="Fail"><Setter Property="Background" Value="{DynamicResource OutcomeFailRow}" /></DataTrigger>
            <DataTrigger Binding="{Binding Outcome}" Value="Timeout"><Setter Property="Background" Value="{DynamicResource OutcomeWarnRow}" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FieldRows" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Ok}" Value="✗"><Setter Property="Background" Value="{DynamicResource OutcomeFailRow}" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ListGrid" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
    </Style>
</ResourceDictionary>
